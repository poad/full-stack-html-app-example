# フロントエンド環境変数 (Astro: ビルド時に import.meta.env.PUBLIC_* として埋め込まれます)

# バックエンド (CloudFront + Lambda Function URL) のドメイン名
# 例: https://d1234567890.cloudfront.net
PUBLIC_API_URL=

# Cognito ユーザープールドメイン (ホスト型UI)
# 例: https://todo-userpool-domain.auth.ap-northeast-1.amazoncognito.com
PUBLIC_COGNITO_DOMAIN=

# Cognito ユーザープールクライアント ID
PUBLIC_COGNITO_CLIENT_ID=
